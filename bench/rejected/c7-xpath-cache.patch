+// Per-thread cache of compiled XPath expressions. Scalar functions evaluate the same constant
+// expression on every row, and compiling it is a measurable share of the call. A compiled
+// expression holds no document state (prefixes resolve at evaluation), so it is reusable across
+// documents. Expressions compile against a document-less context carrying the same silent error
+// handler as the per-document contexts.
+namespace {
+struct XPathCompileCache {
+	static constexpr size_t MAX_ENTRIES = 256;
+	xmlXPathContextPtr compile_ctx = nullptr;
+	std::unordered_map<std::string, xmlXPathCompExprPtr> entries;
+
+	~XPathCompileCache() {
+		Clear();
+		if (compile_ctx) {
+			xmlXPathFreeContext(compile_ctx);
+		}
+	}
+
+	void Clear() {
+		for (auto &entry : entries) {
+			xmlXPathFreeCompExpr(entry.second);
+		}
+		entries.clear();
+	}
+};
+} // namespace
+
+static xmlXPathCompExprPtr CompileXPathCached(const std::string &xpath) {
+	thread_local XPathCompileCache cache;
+	auto it = cache.entries.find(xpath);
+	if (it != cache.entries.end()) {
+		return it->second;
+	}
+	if (!cache.compile_ctx) {
+		cache.compile_ctx = xmlXPathNewContext(nullptr);
+		if (!cache.compile_ctx) {
+			throw InvalidInputException("Invalid XPath expression: '%s'", xpath);
+		}
+		xmlXPathSetErrorHandler(cache.compile_ctx, XMLSilentXPathErrorHandler, nullptr);
+	}
+	xmlXPathCompExprPtr compiled = xmlXPathCtxtCompile(cache.compile_ctx, BAD_CAST xpath.c_str());
+	if (!compiled) {
+		throw InvalidInputException("Invalid XPath expression: '%s'", xpath);
+	}
+	if (cache.entries.size() >= XPathCompileCache::MAX_ENTRIES) {
+		cache.Clear();
+	}
+	cache.entries.emplace(xpath, compiled);
+	return compiled;
+}
+
