-	}
-	xmlXPathObjectPtr result = xmlXPathCompiledEval(compiled, xpath_ctx);
-	xmlXPathFreeCompExpr(compiled);
+	xmlXPathObjectPtr result = xmlXPathCompiledEval(CompileXPathCached(xpath), xpath_ctx);
