@@ -1,8 +1,12 @@
 #pragma once
 
+#include <climits>
 #include <cstddef>
 #include <cstring>
 
+#include <libxml/HTMLparser.h>
+#include <libxml/parser.h>
+
 namespace duckdb {
 
 // Feed libxml2's IO-based parsers (xmlCtxtReadIO / htmlReadIO) from an already-in-memory
@@ -38,4 +42,24 @@ inline int XMLInMemoryReaderClose(void * /*context*/) {
 	return 0;
 }
 
+// Parse an in-memory XML document with a caller-owned parser context. Buffers that fit the
+// int length of xmlCtxtReadMemory parse in place. Only larger ones go through the IO reader,
+// whose fixed-size reads copy the input chunk by chunk.
+inline xmlDocPtr XMLReadBuffer(xmlParserCtxtPtr ctx, const char *data, size_t size, int options) {
+	if (size <= static_cast<size_t>(INT_MAX)) {
+		return xmlCtxtReadMemory(ctx, data, static_cast<int>(size), nullptr, nullptr, options);
+	}
+	XMLInMemoryReader reader {data, size, 0};
+	return xmlCtxtReadIO(ctx, XMLInMemoryReaderRead, XMLInMemoryReaderClose, &reader, nullptr, nullptr, options);
+}
+
+// HTML counterpart of XMLReadBuffer, for htmlReadMemory's int length.
+inline htmlDocPtr HTMLReadBuffer(const char *data, size_t size, const char *encoding, int options) {
+	if (size <= static_cast<size_t>(INT_MAX)) {
+		return htmlReadMemory(data, static_cast<int>(size), nullptr, encoding, options);
+	}
+	XMLInMemoryReader reader {data, size, 0};
+	return htmlReadIO(XMLInMemoryReaderRead, XMLInMemoryReaderClose, &reader, nullptr, encoding, options);
+}
+
 } // namespace duckdb
