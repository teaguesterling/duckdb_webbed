# name: test/sql/sax_ns_keep_children.test
# description: Under namespaces := 'keep', SAX must fill prefixed child columns (dc:creator, content:encoded, media:content) the way DOM does. read_xml names those columns by local name on both paths. Regression for: SAX keyed each child by its prefixed name, so every prefixed column read NULL.
# group: [sql]

require webbed

# media:content also carries its own url attribute alongside its media:credit child. 2bf2618 (this
# file's own commit) predates 263e717 ("fix(read_xml): keep attributes on nested elements") by about
# three minutes, in the same PR: that later commit's whole point is that an element with both
# attributes and children keeps the attributes, leading the STRUCT ("<provider npi=".."><name/></provider>
# became STRUCT(name)" is exactly this shape) -- so content gains a leading url field. This test's
# {'credit': ...}-only expectation was never updated for that sibling fix and went stale on arrival.
query IIII
SELECT title, creator, encoded, content
FROM read_xml('test/xml/sax_ns_keep_children.xml', record_element := 'item', namespaces := 'keep')
ORDER BY title;
----
a	ann	<p>hi</p>	{'url': u1, 'credit': c1}
b	bob	plain	{'url': u2, 'credit': c2}

query IIII
SELECT title, creator, encoded, content
FROM read_xml('test/xml/sax_ns_keep_children.xml', record_element := 'item', namespaces := 'keep',
  maximum_file_size := 1)
ORDER BY title;
----
a	ann	<p>hi</p>	{'url': u1, 'credit': c1}
b	bob	plain	{'url': u2, 'credit': c2}

# An explicit schema names the columns the same way
query II
SELECT title, creator
FROM read_xml('test/xml/sax_ns_keep_children.xml', record_element := 'item', namespaces := 'keep',
  maximum_file_size := 1, columns := {'title': 'VARCHAR', 'creator': 'VARCHAR'})
ORDER BY title;
----
a	ann
b	bob
