# name: test/sql/github_issue_275_heading_slug_ids.test
# description: every HTML heading with no id gets pandoc's auto_identifiers slug, as every duck_blocks reader does
# group: [sql]

#
# GitHub Issue #275: https://github.com/teaguesterling/duckdb_webbed/issues/275
# Rule: duckdb_markdown#111, decided by Teague 2026-11-14.
#
# WHY: section ids, links and anchors must agree across readers (markdown, webbed,
# panduck, dmb). The shared rule is pandoc's auto_identifiers (non-GFM):
#   1. lowercase, across all of Unicode;
#   2. keep letters and numbers of any script, whitespace, '_', '-' and '.';
#   3. split on whitespace and join the words with '-' (other hyphens stay as written);
#   4. drop everything before the first letter;
#   5. an empty result is 'section'.
# Readers do not de-duplicate: repeated headings share an id. ASCII forms
# (percent-encoding, Punycode) belong at output boundaries, not in the stored id.
#
# On by default, agreed with Teague 2026-11-13: this changes default output.
#

require webbed

# Plain text heading
query I
SELECT (html_to_duck_blocks('<h2>Field guide</h2>'))[1].attributes['id'];
----
field-guide

# Letters of any script are kept and lowercased (#111's examples).
query I
SELECT (html_to_duck_blocks('<h2>Café</h2>'))[1].attributes['id'];
----
café

query I
SELECT (html_to_duck_blocks('<h2>日本</h2>'))[1].attributes['id'];
----
日本

query I
SELECT (html_to_duck_blocks('<h2>Zoë''s notes</h2>'))[1].attributes['id'];
----
zoës-notes

query I
SELECT (html_to_duck_blocks('<h2>ÉCOLE Ωμέγα</h2>'))[1].attributes['id'];
----
école-ωμέγα

# pandoc's manual examples.
query I
SELECT (html_to_duck_blocks('<h2>Heading identifiers in HTML</h2>'))[1].attributes['id'];
----
heading-identifiers-in-html

query I
SELECT (html_to_duck_blocks('<h2>Maître d''hôtel</h2>'))[1].attributes['id'];
----
maître-dhôtel

query I
SELECT (html_to_duck_blocks('<h2><em>Dogs</em>?--in <em>my</em> house?</h2>'))[1].attributes['id'];
----
dogs--in-my-house

query I
SELECT (html_to_duck_blocks('<h2><a href="x">HTML</a>, <a href="y">S5</a>, or <a href="z">RTF</a>?</h2>'))[1].attributes['id'];
----
html-s5-or-rtf

query I
SELECT (html_to_duck_blocks('<h2>3. Applications</h2>'))[1].attributes['id'];
----
applications

query I
SELECT (html_to_duck_blocks('<h2>33</h2>'))[1].attributes['id'];
----
section

# Hyphens stay as written; whitespace runs become one '-'; '.' and '_' stay.
query I
SELECT (html_to_duck_blocks('<h2>a -- b</h2>'))[1].attributes['id'];
----
a----b

query I
SELECT (html_to_duck_blocks('<h3>  Hello,   World! (v2.0) </h3>'))[1].attributes['id'];
----
hello-world-v2.0

query I
SELECT (html_to_duck_blocks('<h3>snake_case-and-dash</h3>'))[1].attributes['id'];
----
snake_case-and-dash

# No dedup: repeated headings share an id.
query II
SELECT b[1].attributes['id'], b[2].attributes['id']
FROM (SELECT html_to_duck_blocks('<h2>Dup</h2><h2>Dup</h2>') AS b);
----
dup	dup

# Inline children: the slug is taken from the heading's whole text.
query I
SELECT (html_to_duck_blocks('<h2>Hello <em>big</em> world</h2>'))[1].attributes['id'];
----
hello-big-world

# A given id always wins.
query I
SELECT (html_to_duck_blocks('<h2 id="given">Given id</h2>'))[1].attributes['id'];
----
given

# A given id that capture leaves out is not replaced by a slug: a slug would put an
# id on the block that the source never had.
query I
SELECT map_contains((html_to_duck_blocks('<h2 id="given">Given id</h2>', capture_attributes := false))[1].attributes, 'id');
----
false

# Nothing left after the rule: 'section', as pandoc does.
query I
SELECT (html_to_duck_blocks('<h2>!!!</h2>'))[1].attributes['id'];
----
section

# id sits before heading_level, as a given id does today.
query I
SELECT (html_to_duck_blocks('<h2>No id here</h2>'))[1].attributes::VARCHAR;
----
{id=no-id-here, heading_level=2}

# The file reader takes the same path.
query I
SELECT attributes['id'] FROM read_html_blocks('test/html/blocks/github_issue_275_headings.html') WHERE element_type = 'heading' ORDER BY element_order;
----
field-guide
given
