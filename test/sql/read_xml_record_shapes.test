# name: test/sql/read_xml_record_shapes.test
# description: A record fills a column with its own name only when that column is the whole schema
# group: [sql]

require webbed

# The first <row> has a child <row>, so the schema has columns a and row. The second <row> has no child <row>: its
# row is NULL. It used to read '<a>2</a>', the record itself.
query IT
SELECT a, "row" FROM read_xml('test/xml/record_shapes/selfcol.xml') ORDER BY a;
----
1	x
2	NULL

query IT
SELECT a, "row" FROM read_xml('test/xml/record_shapes/selfcol.xml', maximum_file_size := 1) ORDER BY a;
----
1	x
2	NULL

# A one-column schema named after the record still reads the record: max_depth leaves no room inside it,
# or the column is declared
query T
SELECT "row" FROM read_xml('test/xml/record_shapes/plain.xml', max_depth := 1);
----
<a>1</a>
<a>2</a>

query T
SELECT "row" FROM read_xml('test/xml/record_shapes/plain.xml', max_depth := 1, maximum_file_size := 1);
----
<a>1</a>
<a>2</a>

query T
SELECT "row" FROM read_xml('test/xml/record_shapes/plain.xml', columns := {'row': 'XML'});
----
<a>1</a>
<a>2</a>

# A record nested inside a record of the same name is not a row of its own: it stays in its parent's column, as
# streaming always read it. DOM used to add a row for it.
query IT
SELECT v, item FROM read_xml('test/xml/record_shapes/nested_rec.xml', record_element := 'item') ORDER BY v;
----
1	{'v': 2}
3	NULL

query IT
SELECT v, item FROM read_xml('test/xml/record_shapes/nested_rec.xml', record_element := '//item') ORDER BY v;
----
1	{'v': 2}
3	NULL

query IT
SELECT v, item FROM read_xml('test/xml/record_shapes/nested_rec.xml', record_element := 'item', maximum_file_size := 1) ORDER BY v;
----
1	{'v': 2}
3	NULL

# Any other XPath expression keeps its own node set, nested matches included
query I
SELECT count(*) FROM read_xml('test/xml/record_shapes/nested_rec.xml', record_element := '//*[local-name()=''item'']');
----
3

# Inside a STRUCT, an attribute and a child element with the same name are two fields, as at the top level (#230):
# the attribute takes attr_prefix. The field used to be typed from the child but read from the attribute: 7, not 8.
query TTTT
SELECT p."@id", p.id, p.n, typeof(p) FROM read_xml('test/xml/record_shapes/structcollide.xml') ORDER BY p.id;
----
7	8	z	STRUCT("@id" VARCHAR, id INTEGER, n VARCHAR)
9	10	y	STRUCT("@id" VARCHAR, id INTEGER, n VARCHAR)

query TTT
SELECT p."@id", p.id, p.n FROM read_xml('test/xml/record_shapes/structcollide.xml', maximum_file_size := 1) ORDER BY p.id;
----
7	8	z
9	10	y

# A repeated element becomes a LIST of the same STRUCT
query T
SELECT p FROM read_xml('test/xml/record_shapes/structcollide_list.xml');
----
[{'@id': 1, 'id': 2}, {'@id': 3, 'id': 4}]

query T
SELECT p FROM read_xml('test/xml/record_shapes/structcollide_list.xml', maximum_file_size := 1);
----
[{'@id': 1, 'id': 2}, {'@id': 3, 'id': 4}]

# A custom attr_prefix names the attribute field
query TT
SELECT p."_id", p.id FROM read_xml('test/xml/record_shapes/structcollide.xml', attr_prefix := '_') ORDER BY p.id;
----
7	8
9	10

# Without a clash the attribute keeps its bare name
query TT
SELECT p.id, p.n FROM read_xml('test/xml/record_shapes/struct_noclash.xml');
----
7	z
