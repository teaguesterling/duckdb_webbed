# name: test/sql/github_issue_184_late_column_discovery.test
# description: Under SAX streaming a child element first appearing beyond the sample window was absent from the schema entirely, so querying it was a bind error rather than a NULL column. sample_size <= 0 already streams every record at bind time to widen out-of-sample types; it now also discovers out-of-sample columns. The fixture puts `late` in record 60, outside the 50-record window a non-positive sample_size samples.
# group: [sql]

require webbed

# sample_size := -1 means "look at every value". It now means that for columns too,
# not only for types. Before this fix: Binder Error, Could not find key "late".
query I
SELECT late FROM read_xml('test/xml/late_column_beyond_window.xml', sample_size := -1, streaming := true, maximum_file_size := 1) WHERE late IS NOT NULL;
----
seen

# The discovered column is NULL for every record that lacks it, which is the whole
# point: a missing field should read as absent data, not as a schema error.
query II
SELECT count(*), count(late) FROM read_xml('test/xml/late_column_beyond_window.xml', sample_size := -1, streaming := true, maximum_file_size := 1);
----
60	1

# A discovered column is VARCHAR deliberately: it never appeared in the sampled
# document, so there is no inferred type to widen from.
query I
SELECT typeof(late) FROM read_xml('test/xml/late_column_beyond_window.xml', sample_size := -1, streaming := true, maximum_file_size := 1) LIMIT 1;
----
VARCHAR

# THE REMAINING LIMITATION, asserted so it cannot be mistaken for fixed. A BOUNDED
# sample_size still bounds discovery: the output schema is fixed before the scan and
# DuckDB gives table functions no mid-scan rebind, so a column outside a finite window
# cannot be added. Use sample_size <= 0, or name it in `columns :=`.
statement error
SELECT late FROM read_xml('test/xml/late_column_beyond_window.xml', sample_size := 5, streaming := true, maximum_file_size := 1);
----
late

# And the explicit escape hatch keeps working regardless of the window.
query I
SELECT late FROM read_xml('test/xml/late_column_beyond_window.xml', columns := {'late': 'VARCHAR'}, sample_size := 5, streaming := true, maximum_file_size := 1) WHERE late IS NOT NULL;
----
seen
