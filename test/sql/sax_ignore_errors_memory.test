# name: test/sql/sax_ignore_errors_memory.test
# description: Under ignore_errors, SAX holds a file's rows until the file parses in full; DuckDB's buffer manager tracks them
# group: [sql]

require webbed

statement ok
COPY (SELECT '<root>' || string_agg('<item><t>' || repeat('a', 1000) || '</t></item>', '') || '</root>' FROM range(60000)) TO '__TEST_DIR__/many_records.xml' (HEADER false, QUOTE '', DELIMITER '\x01');

query II
SELECT count(*), sum(length(t)) FROM read_xml('__TEST_DIR__/many_records.xml', record_element := 'item', columns := {'t': 'VARCHAR'}, maximum_file_size := 1, ignore_errors := true);
----
60000	60000000

# With no temp directory to spill to, the held rows count against memory_limit
statement ok
SET temp_directory = '';

statement ok
SET memory_limit = '40MB';

query II
SELECT count(*), sum(length(t)) FROM read_xml('__TEST_DIR__/many_records.xml', record_element := 'item', columns := {'t': 'VARCHAR'}, maximum_file_size := 1);
----
60000	60000000

statement error
SELECT count(*), sum(length(t)) FROM read_xml('__TEST_DIR__/many_records.xml', record_element := 'item', columns := {'t': 'VARCHAR'}, maximum_file_size := 1, ignore_errors := true);
----
Out of Memory
