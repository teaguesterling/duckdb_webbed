# name: test/sql/github_issue_274_native_table_blocks.test
# description: HTML table blocks carry the native {headers, rows} schema with aligned spans and the caption
# group: [sql]

#
# GitHub Issue #274: https://github.com/teaguesterling/duckdb_webbed/issues/274
#
# read_html_blocks already emits element_type='table' with duck_blocks' native content,
# {"headers": [...], "rows": [[...]]} (duck_blocks_spec.md, "Only table carries JSON").
# Query a page's tables with WHERE element_type = 'table'.
#
# WHY spans: duck_block_utils' duck_block_table_read pads a short row with NULL at its
# END. A <td colspan="2"> early in a row therefore moved every later cell one column to
# the left: the value landed under the wrong header with no error. Each spanned position
# is now an empty cell, which duck_block_table_read reads as NULL, and no value is
# repeated (decided 2026-11-13 with Teague). The projection still loses the span itself,
# as the spec says of {headers, rows}.
#
# WHY caption: the <caption> text was dropped. It is the table's title, and it now sits
# in attributes['caption'], beside the table id.
#

require webbed

# --- colspan / rowspan ----------------------------------------------------------

# An early colspan keeps the later cell in its own column.
query I
SELECT (html_to_duck_blocks('<table><tr><th>a</th><th>b</th><th>c</th></tr><tr><td colspan="2">x</td><td>y</td></tr></table>'))[1].content;
----
{"headers":["a","b","c"],"rows":[["x","","y"]]}

# rowspan fills the covered position in the rows below.
query I
SELECT (html_to_duck_blocks('<table><tr><th>a</th><th>b</th></tr><tr><td rowspan="2">x</td><td>1</td></tr><tr><td>2</td></tr></table>'))[1].content;
----
{"headers":["a","b"],"rows":[["x","1"],["","2"]]}

# A rowspan in the middle of a row.
query I
SELECT (html_to_duck_blocks('<table><tr><td>1</td><td rowspan="2">m</td><td>3</td></tr><tr><td>4</td><td>6</td></tr></table>'))[1].content;
----
{"headers":[],"rows":[["1","m","3"],["4","","6"]]}

# colspan and rowspan together cover a block of cells.
query I
SELECT (html_to_duck_blocks('<table><tr><td colspan="2" rowspan="2">z</td><td>1</td></tr><tr><td>2</td></tr><tr><td>a</td><td>b</td><td>c</td></tr></table>'))[1].content;
----
{"headers":[],"rows":[["z","","1"],["","","2"],["a","b","c"]]}

# A header span.
query I
SELECT (html_to_duck_blocks('<table><thead><tr><th colspan="2">ab</th><th>c</th></tr></thead><tbody><tr><td>1</td><td>2</td><td>3</td></tr></tbody></table>'))[1].content;
----
{"headers":["ab","","c"],"rows":[["1","2","3"]]}

# A row span does not cross from <thead> into <tbody> (HTML row groups end spans).
query I
SELECT (html_to_duck_blocks('<table><thead><tr><th rowspan="3">a</th><th>b</th></tr></thead><tbody><tr><td>1</td><td>2</td></tr></tbody></table>'))[1].content;
----
{"headers":["a","b"],"rows":[["1","2"]]}

# A row span reaching past the last row adds no rows.
query I
SELECT (html_to_duck_blocks('<table><tr><td rowspan="5">x</td><td>1</td></tr></table>'))[1].content;
----
{"headers":[],"rows":[["x","1"]]}

# A <tr> with no cells (every position covered from above) still uses up one row of
# each pending span, so the next row is not shifted right.
query I
SELECT (html_to_duck_blocks('<table><tr><td rowspan="2">a</td><td rowspan="2">b</td></tr><tr></tr><tr><td>c</td><td>d</td></tr></table>'))[1].content;
----
{"headers":[],"rows":[["a","b"],["c","d"]]}

query I
SELECT (html_to_duck_blocks('<table><tr><th>a</th><th>b</th></tr><tr><td rowspan="2">x</td><td>1</td></tr><tr></tr><tr><td>p</td><td>q</td></tr></table>'))[1].content;
----
{"headers":["a","b"],"rows":[["x","1"],["p","q"]]}

# --- hostile span values ----------------------------------------------------------

# Non-numeric, zero and negative spans count as 1.
query I
SELECT (html_to_duck_blocks('<table><tr><td colspan="x">a</td><td colspan="-1">b</td><td colspan="0">c</td><td rowspan="0">d</td></tr><tr><td>1</td><td>2</td><td>3</td><td>4</td></tr></table>'))[1].content;
----
{"headers":[],"rows":[["a","b","c","d"],["1","2","3","4"]]}

# colspan is clamped to 1000, the HTML limit: the value plus 999 empty cells.
query I
SELECT (length(c) - length(replace(c, ',""', ''))) // 3
FROM (SELECT (html_to_duck_blocks('<table><tr><td colspan="99999">a</td></tr></table>'))[1].content AS c);
----
999

# Spans cannot multiply a small page into a huge table: filler cells per table are
# capped at 1,000,000 plus one per real cell, about the bound duck_block_table_read
# uses for its own padding. Without it, these 7 KB gave 60 MB of JSON and 1.29 GB of memory (measured
# by the branch review, 2026-11-13). Past the cap, spans stop expanding.
query I
SELECT length(c) < 4000000
FROM (SELECT (html_to_duck_blocks('<table><tr>' || repeat('<td colspan="1000" rowspan="65534"></td>', 100) || '</tr>'
                                  || repeat('<tr><td></td></tr>', 200) || '</table>'))[1].content AS c);
----
true

# --- footers keep their extra key; spans align there too ---------------------------

query I
SELECT (html_to_duck_blocks('<table><tr><th>a</th><th>b</th></tr><tr><td>1</td><td>2</td></tr><tfoot><tr><td colspan="2">t</td></tr></tfoot></table>'))[1].content;
----
{"headers":["a","b"],"rows":[["1","2"]],"footers":[["t",""]]}

# --- caption -------------------------------------------------------------------------

query II
SELECT b.attributes['caption'], b.attributes['id']
FROM (SELECT unnest(html_to_duck_blocks('<table id="t1"><caption>Cap  <b>tion</b></caption><tr><th>a</th></tr><tr><td>1</td></tr></table>')) AS b)
WHERE b.element_type = 'table';
----
Cap tion	t1

# No <caption>, or an empty one: no caption key.
query II
SELECT map_contains((html_to_duck_blocks('<table><tr><td>1</td></tr></table>'))[1].attributes, 'caption'),
       map_contains((html_to_duck_blocks('<table><caption>  </caption><tr><td>1</td></tr></table>'))[1].attributes, 'caption');
----
false	false

# The caption is not in the content, and no pandoc_ast is synthesised.
query II
SELECT contains(b.content, 'Cap'), map_contains(b.attributes, 'pandoc_ast')
FROM (SELECT unnest(html_to_duck_blocks('<table><caption>Cap</caption><tr><td>1</td></tr></table>')) AS b)
WHERE b.element_type = 'table';
----
false	false

# A source attribute named caption cannot override the <caption> element.
query I
SELECT b.attributes['caption']
FROM (SELECT unnest(html_to_duck_blocks('<table caption="forged"><caption>Real</caption><tr><td>1</td></tr></table>', capture_attributes := '*')) AS b)
WHERE b.element_type = 'table';
----
Real

# Without a <caption> element, a source caption attribute is not a caption either.
query I
SELECT map_contains(b.attributes, 'caption')
FROM (SELECT unnest(html_to_duck_blocks('<table caption="forged"><tr><td>1</td></tr></table>', capture_attributes := '*')) AS b)
WHERE b.element_type = 'table';
----
false

# The writer puts the caption back as an element, not as an attribute.
query II
SELECT contains(h, '<caption>Cap</caption>'), contains(h, 'caption="')
FROM (SELECT duck_blocks_to_html(html_to_duck_blocks('<table><caption>Cap</caption><tr><th>a</th></tr><tr><td>1</td></tr></table>')) AS h);
----
true	false

# The file reader takes the same path.
query II
SELECT content, attributes['caption'] FROM read_html_blocks('test/html/blocks/github_issue_274_table.html') WHERE element_type = 'table';
----
{"headers":["a","b","c"],"rows":[["x","","y"]]}	Prices
