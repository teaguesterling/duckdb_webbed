# name: test/sql/read_html_blocks.test
# description: Test read_html_blocks and parse_html_blocks table functions
# group: [sql]

require webbed

# =============================================================================
# Test 1: Basic read_html_blocks on simple HTML file
# =============================================================================

query III
SELECT kind, element_type, content FROM read_html_blocks('test/html/simple.html') ORDER BY element_order;
----
block	heading	Welcome
block	paragraph	This is a test page.

# Test count of blocks in simple.html
query I
SELECT count(*) FROM read_html_blocks('test/html/simple.html');
----
2

# =============================================================================
# Test 2: Attributes and level from simple.html
# =============================================================================

query IIII
SELECT element_type, level, encoding, attributes['heading_level']
FROM read_html_blocks('test/html/simple.html')
ORDER BY element_order;
----
heading	1	text	1
paragraph	1	text	NULL

# =============================================================================
# Test 3: read_html_blocks on complex HTML file
# =============================================================================

# complex.html wraps its content in <nav>/<main>/<article>, which are now
# preserved as `section` blocks with their role rather than flattened away.
# Content blocks therefore sit one level deeper than before.
query II
SELECT kind, element_type FROM read_html_blocks('test/html/complex.html') WHERE kind = 'block';
----
block	heading
block	section
block	list
block	section
block	section
block	heading
block	paragraph
block	image
block	table

# Test structured inlines in complex.html paragraph. Keyed on content
# (element_type = 'paragraph') rather than an element_order window: a
# position-indexed filter breaks on every structural change upstream of the
# target row and asserts nothing about what actually matters.
query IIII
SELECT kind, element_type, content, level
FROM read_html_blocks('test/html/complex.html')
WHERE element_type IN ('paragraph', 'bold', 'italic', 'text')
ORDER BY element_order;
----
block	paragraph	NULL	3
inline	text	This is some content with 	4
inline	bold	bold	4
inline	text	 and 	4
inline	italic	italic	4
inline	text	 text.	4

# =============================================================================
# Test 4: read_html_blocks with filename parameter
# =============================================================================

query IIII
SELECT filename, kind, element_type, content
FROM read_html_blocks('test/html/simple.html', filename := true)
ORDER BY element_order;
----
test/html/simple.html	block	heading	Welcome
test/html/simple.html	block	paragraph	This is a test page.

# Test filename aliases: file_path and include_filepath
query I
SELECT count(*) FROM read_html_blocks('test/html/simple.html', file_path := true);
----
2

query I
SELECT count(*) FROM read_html_blocks('test/html/simple.html', include_filepath := true);
----
2

# =============================================================================
# Test 5: Multi-file reading (glob & list of files)
# =============================================================================

# 11 -> 14: +3 section blocks for <nav>/<main>/<article>, now preserved
# instead of flattened away.
query II
SELECT filename, count(*)
FROM read_html_blocks(['test/html/simple.html', 'test/html/complex.html'], filename := true)
GROUP BY filename
ORDER BY filename;
----
test/html/complex.html	14
test/html/simple.html	2

# Glob pattern reading
query I
SELECT count(*) > 0 FROM read_html_blocks('test/html/s*.html');
----
true

# =============================================================================
# Test 6: parse_html_blocks (in-memory string table function)
# =============================================================================

query III
SELECT kind, element_type, content
FROM parse_html_blocks('<h1>Hello World</h1><p>Test paragraph</p>')
ORDER BY element_order;
----
block	heading	Hello World
block	paragraph	Test paragraph

# Test parse_html_blocks with HTML-typed input
query III
SELECT kind, element_type, content
FROM parse_html_blocks('<h1>HTML Type</h1><p>Content</p>'::HTML)
ORDER BY element_order;
----
block	heading	HTML Type
block	paragraph	Content

# Test parse_html_blocks with array of strings
query II
SELECT element_type, content
FROM parse_html_blocks(['<h1>Doc 1</h1>', '<h2>Doc 2</h2>'])
ORDER BY element_order, content;
----
heading	Doc 1
heading	Doc 2

# =============================================================================
# Test 7: Code blocks and attributes
# =============================================================================

query III
SELECT element_type, content, attributes['language']
FROM parse_html_blocks('<pre><code class="language-python">print("hello")</code></pre>');
----
code	print("hello")	python

# =============================================================================
# Test 8: Frontmatter metadata script extraction
# =============================================================================

query III
SELECT element_type, encoding, content
FROM parse_html_blocks('<script type="application/vnd.frontmatter+yaml">title: Test Document</script><h1>Title</h1>');
----
metadata	yaml	title: Test Document
heading	text	Title

# =============================================================================
# Test 9: Lists and Tables JSON encoding
# =============================================================================

query III
SELECT element_type, encoding, attributes['ordered']
FROM parse_html_blocks('<ul><li>Item 1</li><li>Item 2</li></ul><ol><li>First</li></ol>');
----
list	json	false
list	json	true

query II
SELECT element_type, encoding
FROM parse_html_blocks('<table><tr><th>Col1</th><th>Col2</th></tr><tr><td>A</td><td>B</td></tr></table>');
----
table	json

# =============================================================================
# Test 10: Error handling and ignore_errors
# =============================================================================

statement error
SELECT * FROM read_html_blocks('non_existent_file_pattern_xyz_123.html');
----
No files found matching pattern

query I
SELECT count(*) FROM parse_html_blocks('', ignore_errors := true);
----
0

# =============================================================================
# Test 11: Script, style, noscript, and template filtering
# =============================================================================

# Style tag inside paragraph is filtered out, preserving text
query III
SELECT kind, element_type, content
FROM parse_html_blocks('<p>Hello <style>.cls { color: red; }</style>world</p>')
ORDER BY element_order;
----
block	paragraph	Hello world

# Scripts and styles inside headings and blockquotes are filtered out
query III
SELECT kind, element_type, content
FROM parse_html_blocks('<h1>Title <script>alert(1);</script></h1><blockquote>Quote <style>p { margin: 0; }</style>text</blockquote>')
ORDER BY element_order;
----
block	heading	Title 
block	blockquote	Quote text

# =============================================================================
# Test 12: SVG tag filtering
# =============================================================================

query III
SELECT kind, element_type, content
FROM parse_html_blocks('<p>Click here <svg width="16" height="16"><path d="M0 0h16v16H0z"/></svg> for help</p>')
ORDER BY element_order;
----
block	paragraph	Click here  for help

# =============================================================================
# Test 13: Noscript and template tag filtering
# =============================================================================

query III
SELECT kind, element_type, content
FROM parse_html_blocks('<p>Standard text<noscript><style>.hide{display:none}</style>Please enable JS</noscript><template><div>Modal HTML</div></template></p>')
ORDER BY element_order;
----
block	paragraph	Standard text

# =============================================================================
# Test 14: Mixed inline formatting with styles and scripts
# =============================================================================

query IIII
SELECT kind, element_type, content, level
FROM parse_html_blocks('<p>Read the <strong>documentation</strong> <style>.btn{color:blue}</style> at <a href="https://example.com">our website</a>.<script>track();</script></p>')
ORDER BY element_order;
----
block	paragraph	NULL	1
inline	text	Read the 	2
inline	bold	documentation	2
inline	text	 	2
inline	text	 at 	2
inline	link	our website	2
inline	text	.	2

# =============================================================================
# Test 15: Nested list items and tables with embedded styles/scripts
# =============================================================================

query III
SELECT element_type, encoding, content
FROM parse_html_blocks('<ul><li>First<style>.item{margin:0}</style></li><li>Second<script>log();</script></li></ul>');
----
list	json	["First","Second"]

query III
SELECT element_type, encoding, content
FROM parse_html_blocks('<table><tr><th>Header<style>th{color:red}</style></th></tr><tr><td>Data<script>doWork()</script></td></tr></table>');
----
table	json	{"headers":["Header"],"rows":[["Data"]]}

# =============================================================================
# Test 16: Real-world SDLC playbook HTML snippet reading
# =============================================================================

# Verify frontmatter metadata extraction from snippet
query III
SELECT element_type, encoding, replace(content, chr(10), ' ')
FROM read_html_blocks('test/data/sdlc_playbook_snippet.html')
WHERE element_type = 'metadata';
----
metadata	yaml	title: The AI-Native SDLC playbook author: Anthropic date: 2026-08-27 tags: [ai, sdlc, engineering]

# Verify heading text without script tag
query II
SELECT element_type, trim(content)
FROM read_html_blocks('test/data/sdlc_playbook_snippet.html')
WHERE element_type = 'heading';
----
heading	The AI-Native SDLC playbook

# Verify inline code extraction without style tag
query III
SELECT kind, element_type, content
FROM read_html_blocks('test/data/sdlc_playbook_snippet.html')
WHERE kind = 'inline' AND element_type = 'code';
----
inline	code	intent.md


