query I
SELECT count(*) FROM read_html_blocks('{TEST_DIR}/issue_220_labels/*/*.csv', filename := true) WHERE element_type = 'paragraph' AND content = 'abcd';
----
228

# Any label that did not decode to abcd, by index
query I
SELECT filename FROM read_html_blocks('{TEST_DIR}/issue_220_labels/*/*.csv', filename := true) WHERE element_type = 'paragraph' AND content IS DISTINCT FROM 'abcd';
----

# ============================================================================
# Labels that are not in the standard are ignored, even when iconv opens them
# ============================================================================

# iconv reads "unicode" as UTF-16, which turned ASCII into CJK. The standard maps it to UTF-16LE, and a <meta> is
# ASCII, so the file is read as UTF-8.
query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_unicode_label.html') WHERE element_type = 'paragraph';
----
abcd

# UTF-7 is not a web encoding. Decoding it would turn this text into an <img>.
statement ok
COPY (SELECT '<meta charset=utf-7>+ADw-img src+AD0-x onerror+AD0-alert(1)+AD4-') TO '{TEST_DIR}/issue_220_utf7.html' (HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

query I
SELECT count(*) FROM read_html_blocks('{TEST_DIR}/issue_220_utf7.html') WHERE element_type = 'image';
----
0

# "us" is not a label (us-ascii is). It used to raise, and is now ignored, so the undeclared rule reads windows-1252.
query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_unknown_label_us.html') WHERE element_type = 'paragraph';
----
café

# ============================================================================
# Declared labels decode the bytes the way a browser does
# ============================================================================

query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_koi8_r.html') WHERE element_type = 'paragraph';
----
а

query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_shift_jis.html') WHERE element_type = 'paragraph';
----
あ

query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_gbk.html') WHERE element_type = 'paragraph';
----
你

query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_euc_kr.html') WHERE element_type = 'paragraph';
----
가

query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_big5.html') WHERE element_type = 'paragraph';
----
一

# x-user-defined reads as windows-1252, per the HTML prescan, where 0x80 is the euro sign
query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_x_user_defined.html') WHERE element_type = 'paragraph';
----
€

# "logical" is an ISO-8859-8-I label, and 0xE0 is the Hebrew letter alef
query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_logical.html') WHERE element_type = 'paragraph';
----
א

# ============================================================================
# A byte that isn't UTF-8 reads as U+FFFD, as in a browser, whether the file declares UTF-8 or declares nothing.
# Undeclared bytes are windows-1252 only when they hold no well-formed UTF-8 multibyte sequence.
# ============================================================================

query I
SELECT content FROM read_html_blocks('test/html/encoding/github_issue_220_utf8_one_bad_byte.html') WHERE element_type = 'paragraph';
----
café
a�b

query I
SELECT html_extract_text(html, '//p') FROM read_html('test/html/encoding/github_issue_220_utf8_one_bad_byte.html', columns := {'html': 'HTML'}, record_element := 'html');
----
[café, a�b]

# The bad byte comes first and the file's only UTF-8 sequence straddles the 1024-byte <meta> sniff window
query II
SELECT content = '�', content LIKE '%é tail' FROM read_html_blocks('test/html/encoding/github_issue_220_sniff_boundary.html') WHERE element_type = 'paragraph';
----
true	false
false	true

# A file whose first UTF-8 sequence sits past the first megabyte, so the sniff reads past what it keeps
statement ok
COPY (SELECT repeat('<p>x</p>', 200000) || '<p>é</p>') TO '{TEST_DIR}/issue_220_late_utf8.html' (HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

query II
SELECT count(*), count(*) FILTER (content = 'é') FROM read_html_blocks('{TEST_DIR}/issue_220_late_utf8.html') WHERE element_type = 'paragraph';
----
200001	1

# ============================================================================
# A text node or attribute value past libxml2's 10000000-byte limit names that limit, not an option users can't set
# ============================================================================

statement ok
COPY (SELECT '<p>' || repeat('a', 12000000) || '</p>') TO '{TEST_DIR}/issue_220_long_text.html' (HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT count(*) FROM read_html_blocks('{TEST_DIR}/issue_220_long_text.html');
----
HTML document has a text node or attribute value longer than libxml2's limit of 10000000 bytes

statement ok
COPY (SELECT '<a href="data:' || repeat('a', 12000000) || '">x</a>') TO '{TEST_DIR}/issue_220_long_attr.html' (HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT count(*) FROM read_html_blocks('{TEST_DIR}/issue_220_long_attr.html');
----
HTML document has a text node or attribute value longer than libxml2's limit of 10000000 bytes
