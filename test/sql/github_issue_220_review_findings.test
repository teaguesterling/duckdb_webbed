# name: test/sql/github_issue_220_review_findings.test
# description: Findings from the PR #220 review on HTML charset labels
# group: [sql]

require webbed

# ============================================================================
# Only WHATWG Encoding Standard labels declare a charset. Every label, from the standard's table, decodes ASCII
# unchanged. One file per label, keyed by index, since ':' in a label is not a path character on Windows.
# ============================================================================

statement ok
COPY (SELECT i, '<meta charset=' || label || '><p>abcd</p>' AS html FROM (VALUES
