# name: test/sql/html_unescape_markup.test
# description: html_unescape decodes entities and leaves every other byte alone, markup included
# group: [sql]

require webbed

# A tag is text, not markup, so text after it is kept. These used to read 'see ', 'Tom &  ok' and '&amp;</body></html>'.
query I
SELECT html_unescape('see </body> rest');
----
see </body> rest

query I
SELECT html_unescape('Tom &amp; <Jerry> ok');
----
Tom & <Jerry> ok

query I
SELECT html_unescape('<plaintext>&amp;');
----
<plaintext>&

query I
SELECT html_unescape('<!-- c -->&lt;<script>x</script>');
----
<!-- c --><<script>x</script>

# Decoding runs once, so an escaped entity comes back as that entity's text
query I
SELECT html_unescape('&amp;lt; &#60;b&#x3e;');
----
&lt; <b>

# html_unescape inverts html_escape, markup and all
query I
SELECT html_unescape(html_escape('<a href="x">Tom & Jerry</a>')) = '<a href="x">Tom & Jerry</a>';
----
true

# Deep markup is text too, so it no longer reaches the parser's depth limit
query I
SELECT html_unescape(repeat('<div>', 300) || 'x&amp;' || repeat('</div>', 300)) = repeat('<div>', 300) || 'x&' || repeat('</div>', 300);
----
true

# The input is one text node, so it is decoded in chunks under libxml2's 10,000,000-byte text limit.
# A 17,600,000-byte input with tags used to raise that limit's error.
query I
SELECT length(html_unescape(repeat('<p>abc&amp;</p>', 1100000)));
----
12100000

# A chunk boundary does not split an entity, a CR LF pair or a UTF-8 character
query I
SELECT html_unescape(repeat('a', 999998) || '&amp;b') = repeat('a', 999998) || '&b';
----
true

query I
SELECT html_unescape(repeat('a', 999999) || chr(13) || chr(10) || 'b') = repeat('a', 999999) || chr(10) || 'b';
----
true

query I
SELECT html_unescape(repeat('a', 999999) || 'é' || 'b') = repeat('a', 999999) || 'éb';
----
true
