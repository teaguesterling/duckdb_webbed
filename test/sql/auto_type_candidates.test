# name: test/sql/auto_type_candidates.test
# description: auto_type_candidates restricts the scalar types inference may choose, as read_csv's option of the same name does. VARCHAR is always the fallback.
# group: [sql]

require webbed

# =============================================================================
# The motivating case: identity-bearing text that looks like a decimal. '58.0'
# reads back exactly as DOUBLE, so only excluding DOUBLE keeps it VARCHAR.
# =============================================================================

query II
SELECT typeof(apiVersion), apiVersion
FROM parse_xml('<r><f><apiVersion>58.0</apiVersion></f><f><apiVersion>1.5</apiVersion></f></r>')
ORDER BY apiVersion;
----
DOUBLE	1.5
DOUBLE	58.0

query II
SELECT typeof(apiVersion), apiVersion
FROM parse_xml('<r><f><apiVersion>58.0</apiVersion></f><f><apiVersion>1.5</apiVersion></f></r>',
               auto_type_candidates := ['BIGINT', 'BOOLEAN', 'DATE'])
ORDER BY apiVersion;
----
VARCHAR	1.5
VARCHAR	58.0

# =============================================================================
# The scalar ladder, one case per row: the candidates, the sample text, and the
# type inference chooses. A value takes the narrowest allowed type that reads
# it, so an integer widens to BIGINT and then DOUBLE when narrower types are
# excluded, and falls back to VARCHAR when none is allowed.
# =============================================================================

query III
SELECT * FROM (
    SELECT 'default' AS candidates, '1.5' AS sample, typeof(v) AS inferred
    FROM parse_xml('<r><i><v>1.5</v></i></r>')
    UNION ALL SELECT '[BIGINT, BOOLEAN, DATE]', '1.5', typeof(v)
    FROM parse_xml('<r><i><v>1.5</v></i></r>', auto_type_candidates := ['BIGINT', 'BOOLEAN', 'DATE'])
    UNION ALL SELECT '[DOUBLE]', '1.5', typeof(v)
    FROM parse_xml('<r><i><v>1.5</v></i></r>', auto_type_candidates := ['DOUBLE'])
    UNION ALL SELECT '[BIGINT]', '7', typeof(v)
    FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['BIGINT'])
    UNION ALL SELECT '[DOUBLE]', '7', typeof(v)
    FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['DOUBLE'])
    UNION ALL SELECT '[INTEGER]', '9999999999', typeof(v)
    FROM parse_xml('<r><i><v>9999999999</v></i></r>', auto_type_candidates := ['INTEGER'])
    UNION ALL SELECT '[INTEGER, DOUBLE]', '9999999999', typeof(v)
    FROM parse_xml('<r><i><v>9999999999</v></i></r>', auto_type_candidates := ['INTEGER', 'DOUBLE'])
    UNION ALL SELECT '[VARCHAR]', '7', typeof(v)
    FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['VARCHAR'])
    UNION ALL SELECT '[BOOLEAN]', '1', typeof(v)
    FROM parse_xml('<r><i><v>1</v></i></r>', auto_type_candidates := ['BOOLEAN'])
    UNION ALL SELECT '[BOOLEAN]', 'true', typeof(v)
    FROM parse_xml('<r><i><v>true</v></i></r>', auto_type_candidates := ['BOOLEAN'])
    UNION ALL SELECT '[BOOLEAN, DOUBLE]', '1', typeof(v)
    FROM parse_xml('<r><i><v>1</v></i></r>', auto_type_candidates := ['BOOLEAN', 'DOUBLE'])
    UNION ALL SELECT '[BIGINT]', 'true', typeof(v)
    FROM parse_xml('<r><i><v>true</v></i></r>', auto_type_candidates := ['BIGINT'])
    UNION ALL SELECT '[DATE]', '2024-01-01', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01</v></i></r>', auto_type_candidates := ['DATE'])
    UNION ALL SELECT '[BIGINT]', '2024-01-01', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01</v></i></r>', auto_type_candidates := ['BIGINT'])
    UNION ALL SELECT '[TIMESTAMP]', '2024-01-01', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01</v></i></r>', auto_type_candidates := ['TIMESTAMP'])
    UNION ALL SELECT '[TIMESTAMP]', '2024-01-01 10:00:00', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01 10:00:00</v></i></r>', auto_type_candidates := ['TIMESTAMP'])
    UNION ALL SELECT '[DATE]', '2024-01-01 10:00:00', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01 10:00:00</v></i></r>', auto_type_candidates := ['DATE'])
    UNION ALL SELECT '[DATE, TIMESTAMP]', '2024-01-01', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01</v></i></r>', auto_type_candidates := ['DATE', 'TIMESTAMP'])
    UNION ALL SELECT '[TIMESTAMPTZ]', '2024-01-01', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01</v></i></r>', auto_type_candidates := ['TIMESTAMPTZ'])
    UNION ALL SELECT '[TIMESTAMPTZ]', '2024-01-01 10:00:00', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01 10:00:00</v></i></r>', auto_type_candidates := ['TIMESTAMPTZ'])
    UNION ALL SELECT '[TIMESTAMPTZ]', '2024-01-01 10:00:00+02', typeof(v)
    FROM parse_xml('<r><i><v>2024-01-01 10:00:00+02</v></i></r>', auto_type_candidates := ['TIMESTAMPTZ'])
    UNION ALL SELECT '[TIME]', '10:00:00', typeof(v)
    FROM parse_xml('<r><i><v>10:00:00</v></i></r>', auto_type_candidates := ['TIME'])
    UNION ALL SELECT '[int8, float8, bool]', '7', typeof(v)
    FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['int8', 'float8', 'bool'])
) ORDER BY ALL;
----
[BIGINT, BOOLEAN, DATE]	1.5	VARCHAR
[BIGINT]	2024-01-01	VARCHAR
[BIGINT]	7	BIGINT
[BIGINT]	true	VARCHAR
[BOOLEAN, DOUBLE]	1	DOUBLE
[BOOLEAN]	1	VARCHAR
[BOOLEAN]	true	BOOLEAN
[DATE, TIMESTAMP]	2024-01-01	DATE
[DATE]	2024-01-01	DATE
[DATE]	2024-01-01 10:00:00	VARCHAR
[DOUBLE]	1.5	DOUBLE
[DOUBLE]	7	DOUBLE
[INTEGER, DOUBLE]	9999999999	DOUBLE
[INTEGER]	9999999999	VARCHAR
[TIMESTAMPTZ]	2024-01-01	VARCHAR
[TIMESTAMPTZ]	2024-01-01 10:00:00	VARCHAR
[TIMESTAMPTZ]	2024-01-01 10:00:00+02	TIMESTAMP WITH TIME ZONE
[TIMESTAMP]	2024-01-01	TIMESTAMP
[TIMESTAMP]	2024-01-01 10:00:00	TIMESTAMP
[TIME]	10:00:00	TIME
[VARCHAR]	7	VARCHAR
[int8, float8, bool]	7	BIGINT
default	1.5	DOUBLE

# A widened value still converts: BIGINT and DOUBLE hold what INTEGER would have.
query II
SELECT a, b FROM parse_xml('<r><i><a>7</a><b>8</b></i></r>', auto_type_candidates := ['BIGINT', 'DOUBLE']);
----
7	8

# A date widens to TIMESTAMP when DATE is excluded, at midnight, as read_csv
# reads it. Zoneless text never widens to TIMESTAMPTZ (see the ladder above):
# webbed reads it as UTC where read_csv assumes the session time zone.
query II
SELECT typeof(v), v FROM parse_xml('<r><i><v>2024-01-01</v></i><i><v>2024-02-03</v></i></r>',
                                   auto_type_candidates := ['TIMESTAMP'])
ORDER BY v;
----
TIMESTAMP	2024-01-01 00:00:00
TIMESTAMP	2024-02-03 00:00:00

query I
SELECT p FROM parse_xml('<r><i><p><d>2024-01-01</d><e>x</e></p></i></r>', auto_type_candidates := ['TIMESTAMP']);
----
{'d': '2024-01-01 00:00:00', 'e': x}

# =============================================================================
# Nested STRUCT and LIST shapes are unaffected. Only their scalar leaves, and
# attributes, are restricted.
# =============================================================================

query II
SELECT column_name, column_type FROM (DESCRIBE FROM parse_xml(
    '<r><i ver="1.5"><p><a>1.5</a><c>2</c></p><l><x>1.5</x><x>2.5</x></l></i></r>',
    auto_type_candidates := ['BIGINT']));
----
ver	VARCHAR
p	STRUCT(a VARCHAR, c BIGINT)
l	STRUCT(x VARCHAR[])

query II
SELECT p, l FROM parse_xml(
    '<r><i ver="1.5"><p><a>1.5</a><c>2</c></p><l><x>1.5</x><x>2.5</x></l></i></r>',
    auto_type_candidates := ['BIGINT']);
----
{'a': 1.5, 'c': 2}	{'x': [1.5, 2.5]}

# =============================================================================
# datetime_format: a format whose type is not a candidate, and cannot widen to
# one, never wins, so the value falls through to the numeric ladder and then
# VARCHAR. A date format widens to TIMESTAMP like an undeclared one.
# =============================================================================

query I
SELECT typeof(v) FROM parse_xml('<r><i><v>25/12/2024</v></i></r>', datetime_format := '%d/%m/%Y',
                                auto_type_candidates := ['BIGINT']);
----
VARCHAR

query II
SELECT typeof(v), v FROM parse_xml('<r><i><v>25/12/2024</v></i></r>', datetime_format := '%d/%m/%Y',
                                   auto_type_candidates := ['DATE']);
----
DATE	2024-12-25

query II
SELECT typeof(v), v FROM parse_xml('<r><i><v>25/12/2024</v></i></r>', datetime_format := '%d/%m/%Y',
                                   auto_type_candidates := ['TIMESTAMP']);
----
TIMESTAMP	2024-12-25 00:00:00

# =============================================================================
# Each function accepts the option: read_xml, read_html, parse_xml, parse_html.
# =============================================================================

query IIII
SELECT typeof(id), typeof(age), typeof(salary), typeof(active)
FROM read_html('test/html/all_varchar_data.html', record_element := 'employee',
               auto_type_candidates := ['BIGINT', 'BOOLEAN'])
LIMIT 1;
----
BIGINT	BIGINT	VARCHAR	BOOLEAN

query II
SELECT typeof(v), v FROM parse_html('<html><body><div><v>58.0</v></div></body></html>', record_element := 'div',
                                    auto_type_candidates := ['BIGINT']);
----
VARCHAR	58.0

statement ok
COPY (SELECT '<r><item><v>1</v></item><item><v>2</v></item></r>' AS c)
TO '__TEST_DIR__/atc_ints.xml' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT '<r><item><v>1.5</v></item><item><v>2.25</v></item></r>' AS c)
TO '__TEST_DIR__/atc_decimals.xml' (FORMAT csv, HEADER false, QUOTE '');

query II
SELECT typeof(v), v FROM read_xml('__TEST_DIR__/atc_decimals.xml', auto_type_candidates := ['BIGINT']) ORDER BY v;
----
VARCHAR	1.5
VARCHAR	2.25

# The list-of-files overload takes the option too.
query I
SELECT typeof(v) FROM read_xml(['__TEST_DIR__/atc_ints.xml'], auto_type_candidates := ['DOUBLE']) LIMIT 1;
----
DOUBLE

# =============================================================================
# union_by_name: the merge of per-file types stays inside the candidates.
# One file infers integers, the other decimals.
# =============================================================================

# Control: without the option the union widens INTEGER and DOUBLE to DOUBLE.
query I
SELECT DISTINCT typeof(v) FROM read_xml(['__TEST_DIR__/atc_ints.xml', '__TEST_DIR__/atc_decimals.xml'],
                                        union_by_name := true);
----
DOUBLE

# DOUBLE excluded: the decimals file infers VARCHAR, so the union is VARCHAR and
# every value keeps its spelling.
query II
SELECT typeof(v), v FROM read_xml(['__TEST_DIR__/atc_ints.xml', '__TEST_DIR__/atc_decimals.xml'],
                                  union_by_name := true, auto_type_candidates := ['INTEGER'])
ORDER BY v;
----
VARCHAR	1
VARCHAR	1.5
VARCHAR	2
VARCHAR	2.25

# DOUBLE allowed: the union widens to it as usual.
query I
SELECT DISTINCT typeof(v) FROM read_xml(['__TEST_DIR__/atc_ints.xml', '__TEST_DIR__/atc_decimals.xml'],
                                        union_by_name := true, auto_type_candidates := ['INTEGER', 'DOUBLE']);
----
DOUBLE

query I
SELECT DISTINCT typeof(v) FROM read_html(['__TEST_DIR__/atc_ints.xml', '__TEST_DIR__/atc_decimals.xml'],
                                         record_element := 'item', union_by_name := true,
                                         auto_type_candidates := ['INTEGER']);
----
VARCHAR

# Excluding INTEGER makes every integer file BIGINT, and a BIGINT file beside a
# DOUBLE file merges to VARCHAR: the merge cannot see whether the integers fit a
# DOUBLE exactly. One file with both is DOUBLE.
query I
SELECT DISTINCT typeof(v) FROM read_xml(['__TEST_DIR__/atc_ints.xml', '__TEST_DIR__/atc_decimals.xml'],
                                        union_by_name := true, auto_type_candidates := ['BIGINT', 'DOUBLE']);
----
VARCHAR

# A date file and a timestamp file both infer TIMESTAMP under ['TIMESTAMP'],
# through different formats. Neither file's format may read the other's values.
statement ok
COPY (SELECT '<r><i><v>2024-01-01</v></i><i><v>2024-01-02</v></i></r>' AS c)
TO '__TEST_DIR__/atc_dates.xml' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT '<r><i><v>2024-01-01 10:00:00</v></i><i><v>2024-01-02 11:30:00</v></i></r>' AS c)
TO '__TEST_DIR__/atc_timestamps.xml' (FORMAT csv, HEADER false, QUOTE '');

foreach files ['__TEST_DIR__/atc_dates.xml','__TEST_DIR__/atc_timestamps.xml'] ['__TEST_DIR__/atc_timestamps.xml','__TEST_DIR__/atc_dates.xml']

query II
SELECT typeof(v), v FROM read_xml(${files}, union_by_name := true, auto_type_candidates := ['TIMESTAMP']) ORDER BY v;
----
TIMESTAMP	2024-01-01 00:00:00
TIMESTAMP	2024-01-01 10:00:00
TIMESTAMP	2024-01-02 00:00:00
TIMESTAMP	2024-01-02 11:30:00

endloop

# Zoneless text never becomes TIMESTAMPTZ, including through a union with a
# zoned file. Within one file the mix is VARCHAR, and so is the union.
statement ok
COPY (SELECT '<r><i><v>2024-01-01 10:00:00+02</v></i></r>' AS c)
TO '__TEST_DIR__/atc_zoned.xml' (FORMAT csv, HEADER false, QUOTE '');

query I
SELECT DISTINCT typeof(v) FROM read_xml(['__TEST_DIR__/atc_dates.xml', '__TEST_DIR__/atc_zoned.xml'],
                                        union_by_name := true, auto_type_candidates := ['DATE', 'TIMESTAMPTZ']);
----
VARCHAR

query I
SELECT DISTINCT typeof(v) FROM read_xml(['__TEST_DIR__/atc_timestamps.xml', '__TEST_DIR__/atc_zoned.xml'],
                                        union_by_name := true);
----
VARCHAR

# =============================================================================
# Values past the sample: a value the inferred type cannot read is an error, or
# NULL under ignore_errors, never a silent NULL.
# =============================================================================

# 0 and 1 are integers, so excluding the integer types leaves them VARCHAR
# rather than BOOLEAN, and an out-of-sample 2 keeps its spelling.
statement ok
COPY (SELECT '<r>' || repeat('<i><v>1</v></i><i><v>0</v></i>', 30) || '<i><v>2</v></i></r>' AS c)
TO '__TEST_DIR__/atc_zero_one.xml' (FORMAT csv, HEADER false, QUOTE '');

query II
SELECT typeof(v), count(*) FROM read_xml('__TEST_DIR__/atc_zero_one.xml', sample_size := 50,
                                         auto_type_candidates := ['BOOLEAN']) GROUP BY ALL;
----
VARCHAR	61

statement ok
COPY (SELECT '<r>' || repeat('<i><v>true</v></i>', 30) || '<i><v>maybe</v></i></r>' AS c)
TO '__TEST_DIR__/atc_maybe.xml' (FORMAT csv, HEADER false, QUOTE '');

statement error
SELECT * FROM read_xml('__TEST_DIR__/atc_maybe.xml', sample_size := 10, auto_type_candidates := ['BOOLEAN']);
----
value 'maybe' does not match column type BOOLEAN

statement error
SELECT * FROM read_xml('__TEST_DIR__/atc_maybe.xml', sample_size := 10, maximum_file_size := 16, streaming := true,
                       auto_type_candidates := ['BOOLEAN']);
----
value 'maybe' does not match column type BOOLEAN

query II
SELECT count(*), count(v) FROM read_xml('__TEST_DIR__/atc_maybe.xml', sample_size := 10, ignore_errors := true,
                                        auto_type_candidates := ['BOOLEAN']);
----
31	30

# An out-of-sample decimal in a BIGINT column is an error, not a rounded integer.
statement ok
COPY (SELECT '<r>' || repeat('<i><v>7</v></i>', 30) || '<i><v>2.75</v></i></r>' AS c)
TO '__TEST_DIR__/atc_late_decimal.xml' (FORMAT csv, HEADER false, QUOTE '');

statement error
SELECT * FROM read_xml('__TEST_DIR__/atc_late_decimal.xml', sample_size := 10, auto_type_candidates := ['BIGINT']);
----
value '2.75' does not match column type BIGINT

# =============================================================================
# TIMETZ keeps each value's offset, zero or not.
# =============================================================================

query II
SELECT typeof(v), v FROM parse_xml('<r><i><v>10:00:00+02</v></i><i><v>11:30:00-05:30</v></i></r>',
                                   datetime_format := '%H:%M:%S%z', auto_type_candidates := ['TIMETZ'])
ORDER BY v;
----
TIME WITH TIME ZONE	10:00:00+02
TIME WITH TIME ZONE	11:30:00-05:30

# =============================================================================
# Validation matches read_csv: a list of type-name strings, at least one, no
# NULLs, and unknown names are a catalog error.
# =============================================================================

statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := 'BIGINT');
----
requires a list as input

statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := []);
----
requires at least one type

statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := NULL::VARCHAR[]);
----
cannot be NULL

statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['BIGINT', NULL]);
----
cannot contain NULL types

statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := [1]);
----
requires a type specification as string

statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['NOT_A_TYPE']);
----
Type with name NOT_A_TYPE does not exist

# Types read_csv accepts but webbed inference never produces are rejected
# rather than silently ignored.
statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['SMALLINT']);
----
does not accept SMALLINT

statement error
SELECT * FROM read_xml('__TEST_DIR__/atc_ints.xml', auto_type_candidates := ['DECIMAL(10,2)']);
----
does not accept DECIMAL(10,2)

statement error
SELECT * FROM read_html('__TEST_DIR__/atc_ints.xml', auto_type_candidates := ['STRUCT(a INTEGER)']);
----
does not accept STRUCT(a INTEGER)

# XML is VARCHAR under an alias, as JSON is. Inference never produces either.
statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['XML']);
----
does not accept XML

# =============================================================================
# Conflicts: columns turns inference off, and all_varchar already fixes every
# scalar to VARCHAR. Each pairing is an error on every function.
# =============================================================================

statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['BIGINT'], columns := {'v': 'INTEGER'});
----
cannot use both "columns" parameter and "auto_type_candidates" option

statement error
SELECT * FROM read_xml('__TEST_DIR__/atc_ints.xml', auto_type_candidates := ['BIGINT'], columns := {'v': 'INTEGER'});
----
cannot use both "columns" parameter and "auto_type_candidates" option

statement error
SELECT * FROM read_html('__TEST_DIR__/atc_ints.xml', auto_type_candidates := ['BIGINT'], columns := {'v': 'INTEGER'});
----
cannot use both "columns" parameter and "auto_type_candidates" option

statement error
SELECT * FROM parse_html('<div><v>7</v></div>', auto_type_candidates := ['BIGINT'], columns := {'v': 'INTEGER'});
----
cannot use both "columns" parameter and "auto_type_candidates" option

statement error
SELECT * FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['BIGINT'], all_varchar := true);
----
cannot use both "all_varchar" and "auto_type_candidates" options

statement error
SELECT * FROM read_xml('__TEST_DIR__/atc_ints.xml', auto_type_candidates := ['BIGINT'], all_varchar := true);
----
cannot use both "all_varchar" and "auto_type_candidates" options

statement error
SELECT * FROM read_html('__TEST_DIR__/atc_ints.xml', auto_type_candidates := ['BIGINT'], all_varchar := true);
----
cannot use both "all_varchar" and "auto_type_candidates" options

statement error
SELECT * FROM parse_html('<div><v>7</v></div>', auto_type_candidates := ['BIGINT'], all_varchar := true);
----
cannot use both "all_varchar" and "auto_type_candidates" options

# all_varchar := false does not conflict.
query I
SELECT typeof(v) FROM parse_xml('<r><i><v>7</v></i></r>', auto_type_candidates := ['BIGINT'], all_varchar := false);
----
BIGINT

# Dates beside timestamps read as TIMESTAMP in one file, as in a union of a date file and a
# timestamp file. Without TIMESTAMP as a candidate they stay VARCHAR.
query TT
SELECT typeof(v), v FROM parse_xml('<r><i><v>2024-01-01</v></i><i><v>2024-01-02 10:00:00</v></i></r>') ORDER BY v;
----
TIMESTAMP	2024-01-01 00:00:00
TIMESTAMP	2024-01-02 10:00:00

query T
SELECT DISTINCT typeof(v) FROM parse_xml('<r><i><v>2024-01-01</v></i><i><v>2024-01-02 10:00:00</v></i></r>', auto_type_candidates := ['DATE']);
----
VARCHAR
